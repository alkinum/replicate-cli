{
  "name": "@alkinum/replicate-cli",
  "version": "0.1.1",
  "description": "AI-first Replicate CLI for model discovery, schema inspection, predictions, artifacts, and resource management.",
  "type": "module",
  "license": "MIT",
  "author": "Alkinum",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alkinum/replicate-cli.git"
  },
  "homepage": "https://github.com/alkinum/replicate-cli#readme",
  "bugs": "https://github.com/alkinum/replicate-cli/issues",
  "bin": {
    "replicate": "./dist/cli.js"
  },
  "files": [
    "dist",
    "skills",
    "docs/assets/readme-banner.svg",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "build": "pnpm run clean && tsup",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "dev": "tsx src/cli.ts",
    "format": "prettier --write .",
    "link:global": "pnpm build && pnpm add --global .",
    "lint": "eslint .",
    "prepack": "pnpm build",
    "prepublishOnly": "pnpm run check",
    "publish:public": "pnpm run check && npm publish --access public",
    "release:check": "pnpm run check && pnpm build",
    "release:dry-run": "pnpm run check && npm pack --dry-run",
    "start": "tsx src/cli.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.7.1",
    "commander": "^15.0.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.5.0",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "tsup": "^8.5.1",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^5.0.0"
  },
  "packageManager": "pnpm@12.3.4"
}
